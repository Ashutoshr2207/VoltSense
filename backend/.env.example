# VoltSense Backend Environment Configuration Template
# Copy this file to backend/.env and configure your local settings.

# Node environment (development, test, production)
NODE_ENV=development

# Server port
PORT=5000

# MongoDB Connection String (e.g., local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/voltsense
MONGODB_DATABASE=voltsense

# Authentication (Minimum 32 characters in production)
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# File Upload Limits
MAX_FILE_SIZE_MB=50

# ML Inference Service Endpoint
ML_SERVICE_URL=http://127.0.0.1:8000

# Optional: AI Insights & Explanations (Groq Cloud API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Open Charge Map API Key for real-time station data
OCM_API_KEY=
